{
  "name": "openburn",
  "version": "0.6.1",
  "description": "OpenBurn — open-source laser cutting & engraving software with LightBurn .lbrn/.lbrn2 import and export, GRBL control and an animated preview.",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "dev:electron": "concurrently -k \"vite\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "build": "tsc --noEmit && vite build && tsc -p electron/tsconfig.json",
    "build:app": "npm run build && electron-builder",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "fabric": "^6.5.1",
    "imagetracerjs": "^1.2.6",
    "opentype.js": "^1.3.4",
    "paper": "^0.12.18",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/opentype.js": "^1.3.10",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "puppeteer-core": "^25.16.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.openburn.app",
    "productName": "OpenBurn",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "mac": {
      "category": "public.app-category.graphics-design"
    },
    "linux": {
      "target": "AppImage",
      "category": "Graphics"
    },
    "win": {
      "target": "nsis"
    }
  },
  "license": "MIT",
  "author": "Santiago Leal (SJLS27)",
  "homepage": "https://github.com/SJLS27/openburn#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/SJLS27/openburn.git"
  },
  "bugs": {
    "url": "https://github.com/SJLS27/openburn/issues"
  },
  "keywords": [
    "laser",
    "laser-cutter",
    "laser-engraver",
    "lightburn",
    "lbrn2",
    "grbl",
    "gerber",
    "electron",
    "react",
    "typescript",
    "fabricjs",
    "paperjs",
    "cad",
    "cam"
  ]
}
