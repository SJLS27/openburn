---
import { links } from '../content/links';
import type { FooterContent, Lang, UiContent } from '../content/types';

interface Props {
  lang: Lang;
  footer: FooterContent;
  ui: UiContent;
}

const { lang, footer, ui } = Astro.props;
const homeHref = lang === 'es' ? '/es/' : '/';
const privacyHref = lang === 'es' ? '/es/privacidad/' : '/privacy/';
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <a class="brand" href={homeHref} aria-label="OpenBurn">
          <svg class="brand-mark" viewBox="0 0 64 64" aria-hidden="true">
            <rect width="64" height="64" rx="14" fill="#24262a"></rect>
            <path
              d="M32 8c4.3 8.6.8 12.6-2.4 16.4-3.2 3.8-6.4 7.5-3.2 13.4 0-3.7 2.4-5.9 4.8-8 .5 2.9 2.1 5.1 4.3 6.7 2.4 1.8 3.2 4 1.9 7 5.9-3.2 9.4-8.8 9.4-15.3 0-9.7-6.7-16.6-14.8-20.2Z"
              fill="#e07a2c"></path>
          </svg>
          <span>OpenBurn</span>
        </a>
        <p>{footer.tagline}</p>
      </div>

      <nav class="footer-col" aria-label={footer.product.title}>
        <h3>{footer.product.title}</h3>
        {footer.product.links.map((link) => <a href={link.href}>{link.label}</a>)}
      </nav>

      <nav class="footer-col" aria-label={footer.resources.title}>
        <h3>{footer.resources.title}</h3>
        {footer.resources.links.map((link) => <a href={link.href}>{link.label}</a>)}
      </nav>

      <nav class="footer-col" aria-label={footer.community.title}>
        <h3>{footer.community.title}</h3>
        {footer.community.links.map((link) => <a href={link.href}>{link.label}</a>)}
      </nav>
    </div>

    <div class="footer-bottom">
      <p>{footer.license}</p>
      <p>
        <a href={privacyHref}>{ui.privacy}</a>
        <span aria-hidden="true"> · </span>
        <a href={links.changelog} target="_blank" rel="noopener">{ui.changelog}</a>
        <span aria-hidden="true"> · </span>
        <a href={links.github} target="_blank" rel="noopener">{ui.source}</a>
      </p>
    </div>

    <p class="footer-disclaimer">{footer.disclaimer}</p>
    <p class="footer-disclaimer">{footer.madeWith}</p>
  </div>
</footer>
