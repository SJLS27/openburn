---
interface Props {
  name: string;
  alt: string;
  width?: number;
  height?: number;
  priority?: boolean;
  sizes?: string;
  class?: string;
}

const {
  name,
  alt,
  width = 1600,
  height = 1000,
  priority = false,
  sizes = '(max-width: 900px) 100vw, 1040px',
  class: className,
} = Astro.props;
---

<img
  src={`/screenshots/${name}-1200.webp`}
  srcset={`/screenshots/${name}-800.webp 800w, /screenshots/${name}-1200.webp 1200w, /screenshots/${name}-1600.webp 1600w`}
  sizes={sizes}
  width={width}
  height={height}
  alt={alt}
  loading={priority ? 'eager' : 'lazy'}
  fetchpriority={priority ? 'high' : 'auto'}
  decoding="async"
  class={className}
/>
